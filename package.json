{
  "name": "cartographer",
  "description": "倍速会議 — 認識を可視化し合意形成を促進するWebサービス",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "agent": "tsx agents/index.ts",
    "test": "npm run lint && npm run test:unit && npm run build",
    "preflight": "npm run test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:smoke": "bash tests/smoke/smoke.sh",
    "lint": "biome check && node scripts/hardcoded-japanese.mjs && node scripts/check-design-system-copy.mjs --self-only",
    "format": "biome format --write",
    "ds:check": "node scripts/check-design-system-copy.mjs",
    "db:types": "npx supabase gen types typescript --local 2>/dev/null | grep -v 'Supabase CLI' | grep -v 'recommend updating' | grep -v 'Connecting to db' | grep -v 'WARN:' > app/lib/database.types.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "@formatjs/intl-localematcher": "^0.9.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-switch": "^1.2.6",
    "@sentry/nextjs": "^10.42.0",
    "@supabase/supabase-js": "^2.98.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-table": "^8.21.3",
    "@workos-inc/authkit-nextjs": "^4.5.0",
    "@workos-inc/node": "^10.14.0",
    "axios": "^1.21.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.35.1",
    "github-markdown-css": "^5.9.0",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.12.0",
    "mermaid": "^11.16.0",
    "ml-pca": "^4.1.1",
    "next": "^15.5.18",
    "next-intl": "4.4.0",
    "next-themes": "^0.4.6",
    "pdf-parse": "1.1.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.3.5",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.0.18",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.13",
    "postcss": "^8.5.32"
  }
}
