# 倍速会議 (Cartographer) — environment variables
#
# Copy to `.env.local` (Next.js dev server) and fill in the values.
# The canonical list of runtime variables is `env-contract.json`; the Nix
# launcher (`nix run .#cartographer-frontend`) refuses to start when a
# required one is missing. Never commit real values.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Supabase (PostgreSQL + Realtime). `supabase start` prints these for a local stack.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Bypasses RLS — keep it out of anything exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# LLM (OpenRouter). https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
# Model IDs (defaults in app/lib/llm-models.ts)
# LLM_FAST_MODEL=
# LLM_ACCURATE_MODEL=

# ---------------------------------------------------------------------------
# Recommended for any shared deployment
# ---------------------------------------------------------------------------

# HMAC key for signed participant tokens. Generate with: openssl rand -base64 32
# Unset → signed tokens are not issued and legacy raw UUIDs keep being accepted.
PARTICIPANT_TOKEN_SECRET=
# Set to `false` only to keep accepting legacy raw-UUID tokens during a migration.
# PARTICIPANT_TOKEN_ENFORCE=
# Participant-token issuance limit per IP per minute (default 30).
# PARTICIPANT_TOKEN_RATE_LIMIT_PER_MIN=30
# HMAC key for user-id aliases (u_…). Falls back to PARTICIPANT_TOKEN_SECRET.
# USER_ALIAS_SECRET=
# Pins Server Action IDs across builds. Generate with: openssl rand -base64 32
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# Public base URL (OGP, links).
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Optional: sign-in with WorkOS AuthKit (set all three or none)
# ---------------------------------------------------------------------------
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
# openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback
# WORKOS_LEGACY_CLAIM=

# ---------------------------------------------------------------------------
# Optional: legacy Supabase Auth project (only needed while migrating old accounts)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_AUTH_SUPABASE_URL=
# NEXT_PUBLIC_AUTH_SUPABASE_ANON_KEY=
# AUTH_SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Optional: Haskell backend (Project:M36 projection)
# ---------------------------------------------------------------------------
# HASKELL_BACKEND_URL=http://localhost:8080
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55322/postgres?sslmode=disable"
# M36_DATA_PATH=.m36-data
# process-compose port (flake.nix also has a default)
PC_PORT_NUM=9999

# ---------------------------------------------------------------------------
# Optional: access restriction (middleware.ts)
# ---------------------------------------------------------------------------
# Comma-separated IP allowlist. Empty → no IP restriction.
# ALLOWED_IPS=
# Basic auth. Empty → disabled.
# BASIC_AUTH_USERNAME=
# BASIC_AUTH_PASSWORD=
# BASIC_AUTH_REALM=Restricted

# ---------------------------------------------------------------------------
# Optional: security headers / embedding
# ---------------------------------------------------------------------------
# `report-only` puts CSP in observe mode (default: enforce).
# CSP_MODE=
# Space-separated origins allowed to frame /embed/* pages.
# EMBED_FRAME_ANCESTORS=

# ---------------------------------------------------------------------------
# Optional: observability
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# Build-time only (source map upload)
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# NEXT_PUBLIC_UMAMI_URL=
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# ---------------------------------------------------------------------------
# Local development only — never set in production
# ---------------------------------------------------------------------------
# Route LLM calls through a locally installed CLI instead of OpenRouter: claude-cli | codex-cli
# LLM_PROVIDER=
# SURVEY_STATEMENTS_MODEL=
